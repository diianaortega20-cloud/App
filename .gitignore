# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.angular
/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode
/coverage
/dist
/node_modules
/platforms
/plugins
/www

# Stray Gradle cache (native build artifacts live under android/)
/.gradle

/android/.idea/


# Backend PHP - configuracion local
/backend/config/database.php
/backend/config/database.local.php

# Variables de entorno y credenciales
.env
.env.*
!.env.example

# Archivos SQL con datos locales
*.sql.gz

# Configuracion local de Android
/android/local.properties